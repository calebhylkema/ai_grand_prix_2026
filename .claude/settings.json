{
  "permissions": {
    "allow": [
      "Read(**)",
      "Write(src/**)",
      "Write(tests/**)",
      "Write(deployments/**)",
      "Write(docs/**)",
      "Write(tools/**)",
      "Bash(uv run *)",
      "Bash(python *)",
      "Bash(git *)",
      "Bash(docker *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write(*.py)",
        "hooks": [
          {
            "type": "command",
            "command": "cd ${PROJECT_ROOT} && uv run ruff check --fix ${CLAUDE_TOOL_INPUT_FILE_PATH} 2>/dev/null; uv run ruff format ${CLAUDE_TOOL_INPUT_FILE_PATH} 2>/dev/null; true"
          }
        ]
      }
    ]
  }
}
